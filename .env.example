# IDX BSJP Screener Environment Variables
PORT=3000
NODE_ENV=development

# Market Data Source Configuration
# Options: 'hybrid' (default - real IDX parquet + Yahoo Finance + synthetic late-session ticks), 'yahoo', 'mock'
DATA_FEED_MODE=hybrid

# Optional Webhook Endpoints for 15:45 WIB Late Session Alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional Database for Screener Logs and User Watchlists
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional Redis / Upstash Cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

